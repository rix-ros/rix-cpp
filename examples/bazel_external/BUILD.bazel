load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary", "cc_test")

cc_library(
    name = "simple_subscriber_lib",
    srcs = ["simple_subscriber.cpp"],
    hdrs = ["simple_subscriber.hpp"],
    deps = [
        "@rix",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "simple_subscriber",
    srcs = ["main.cpp"],
    deps = [
        ":simple_subscriber_lib",
        "@rix",
    ],
)

cc_test(
    name = "simple_subscriber_test",
    srcs = ["test.cpp"],
    deps = [
        ":simple_subscriber_lib",
        "@rix",
        "@googletest//:gtest_main",
    ],
)
